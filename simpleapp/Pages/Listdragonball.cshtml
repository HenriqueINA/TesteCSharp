@page
@model DragonBallModel
@{
    ViewData["Title"] = "DragonBall";
}

<h1>Lista de Personagens</h1>

@if (Model.Dragonball?.Count > 0)
{
    <div style="display: flex; flex-wrap: wrap;">
        @foreach (var dragonball in Model.Dragonball)
        {
            <div style="border: 1px solid #ccc; margin: 10px; padding: 10px; width: 200px;">
                <p><strong>ID: @dragonball.id</strong></p>
                <img src="@dragonball.image" alt="imagem de @dragonball.name" width="100" />
                <p><strong>@dragonball.name</strong></p>
                <a asp-page="/Infodragonball" asp-route-id="@dragonball.id">Ver Info</a>
            </div>
        }
    </div>
}
else
{
    <p>ERRO : não temos lista </p>
}